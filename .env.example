# Copy this file to .env for local development.
# For Vercel, set the same variables in Project Settings > Environment Variables.
# Do not commit real secrets.

# Required on local + Vercel: Turso / libSQL database.
# Create the database and token from https://turso.tech.
DATABASE_URL=libsql://your-db-org.turso.io
DATABASE_AUTH_TOKEN=

# Required on local + Vercel: canonical site URL for SEO, sitemap, and Open Graph tags.
# Use your primary production domain without a trailing slash.
VITE_SITE_URL=https://faizintifada.com
SITE_URL=https://faizintifada.com

# Local development only: Hono API port used by bun run dev.
# Vercel ignores this because the API runs as a serverless function.
API_PORT=3001

# Vercel production/preview: comma-separated browser origins allowed by the API.
# Use your deployed frontend domains here.
# Example: CORS_ORIGIN=https://your-site.vercel.app,https://your-domain.com
CORS_ORIGIN=

# Optional split deployment only.
# Leave empty/commented when frontend and backend are unified on one Vercel domain.
# If frontend is hosted separately, set the full API origin.
# VITE_API_URL=https://your-api.example.com

# Required on local + Vercel: CMS admin Bearer token for protected /api/admin routes.
# Use a long random value and keep it secret.
CMS_ADMIN_TOKEN=

# Required on local + Vercel: UploadThing server token from https://uploadthing.com/dashboard.
# Server-only secret. Do not expose this with a VITE_ prefix.
UPLOADTHING_TOKEN=

# Required on local + Vercel: GitHub GraphQL token for the contribution calendar.
# Server-only secret. Do not expose this with a VITE_ prefix.
GITHUB_TOKEN=
GITHUB_USERNAME=faizintifada

# Optional split deployment only.
# Leave empty/commented when /api/uploadthing is on the same Vercel domain.
# VITE_UPLOADTHING_URL=https://your-api.example.com

# faiz-ui Starter Kit store (/ui page).
# Canonical site URL used for the Mayar post-payment redirect (no trailing slash).
SITE_URL=https://faizintifada.com
# Server-side price (source of truth; client amount is never trusted).
FAIZ_UI_PRICE_IDR=99000

# Mayar payment gateway (server-only secrets — no VITE_ prefix).
# API key from https://web.mayar.id → Integration → API Key (Read & Write).
# Checkout returns 503 until this is set.
MAYAR_API_KEY=
# 'production' (api.mayar.id) — anything else defaults to sandbox (api.mayar.club).
MAYAR_ENV=production
# Optional: override the Mayar API base URL entirely (rarely needed).
# MAYAR_API_BASE=
# Unguessable secret that forms the webhook path you register in Mayar:
# https://faizintifada.com/api/mayar/webhook/THIS_VALUE
# Webhook returns 404 until this is set.
MAYAR_WEBHOOK_SECRET=

# Fulfillment email (RESEND_API_KEY is already required above).
# From address — domain must be verified in Resend. Defaults to noreply@faizintifada.com.
FAIZ_UI_FROM_EMAIL=Faiz UI <noreply@faizintifada.com>

# What the Buyer receives by email after a paid order (fill in when ready).
FAIZ_UI_ACCESS_TOKEN=
FAIZ_UI_INSTALL_COMMAND=

# --- Latest Videos (homepage YouTube section) ---
# Required for most hosts: YouTube RSS often returns 404 from servers/datacenters.
# When YOUTUBE_API_KEY is set, the API uses YouTube Data API v3 first (RSS as fallback).
# The homepage section is hidden if /api/youtube/videos fails (check server logs).
# Local dev: run `bun run dev` (Vite + API). Frontend-only `dev:vite` will hide the section.
#
# Create a key at https://console.cloud.google.com/ → enable YouTube Data API v3.
# Server-only secret. Do not use a VITE_ prefix.
# YOUTUBE_API_KEY=
#
# Optional — channel handle (default: faizintifada)
# YOUTUBE_CHANNEL_HANDLE=faizintifada
#
# Optional — skip HTML lookup (recommended with API key)
# YOUTUBE_CHANNEL_ID=UCrWK10cz2En42V_eUNMuNVQ
#
# Optional — full RSS URL override
# YOUTUBE_FEED_URL=https://www.youtube.com/feeds/videos.xml?channel_id=UCrWK10cz2En42V_eUNMuNVQ
