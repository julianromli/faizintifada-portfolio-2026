# Turso / libSQL (from https://turso.tech — create database and issue token)
DATABASE_URL=libsql://your-db-org.turso.io
DATABASE_AUTH_TOKEN=

# API server (scripts + Hono)
API_PORT=3001

# Production: comma-separated allowed browser origins (omit to use localhost defaults)
# CORS_ORIGIN=https://your-site.com,https://www.your-site.com

# Production: full URL of API if frontend is hosted separately (omit in dev — Vite proxies /api)
# VITE_API_URL=https://your-api.example.com
