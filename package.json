{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "dev": "concurrently -n vite,api -c blue,green \"bun run dev:vite\" \"bun run dev:api\"",
    "build": "vite build",
    "cf:dev": "bun run build && wrangler dev",
    "deploy:cf": "bun run build && wrangler deploy",
    "start": "bun server/production.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-projects.ts",
    "db:seed:testimonials": "tsx scripts/seed-testimonials.ts",
    "db:seed:speaking": "tsx scripts/seed-speaking-events.ts",
    "doctor": "npx react-doctor@latest",
    "email": "email dev --dir emails --port 3001"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@libsql/client": "^0.17.3",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "@tailwindcss/vite": "^4.1.14",
    "@uploadthing/react": "^7.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "browser-image-compression": "2.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "hono": "^4.12.18",
    "motion": "^12.23.24",
    "overlayscrollbars": "^2.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.2",
    "resend": "^6.16.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "agentation": "^3.0.2",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "react-doctor": "^0.2.9",
    "react-email": "^6.6.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "wrangler": "^4.105.0"
  }
}
